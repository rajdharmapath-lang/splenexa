PORT=3000
NODE_ENV=development

# Public app setting; this URL is embedded in the mobile app.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-splenexa-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-splenexa-project-public-anon-key

# Server-only Supabase credentials. Do not use the anon key here.
SUPABASE_URL=https://your-splenexa-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-splenexa-project-server-only-service-role-key

# MSG91 OTP Widget credentials.
MSG91_TOKEN_AUTH=your-msg91-token-auth
MSG91_WIDGET_ID=your-msg91-widget-id

# Generate a unique, random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
